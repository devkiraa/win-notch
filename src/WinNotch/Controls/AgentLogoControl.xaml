<UserControl x:Class="WinNotch.Controls.AgentLogoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinNotch"
             x:Name="RootLogoControl">
    <Border Width="{Binding BoxSize, ElementName=RootLogoControl}"
            Height="{Binding BoxSize, ElementName=RootLogoControl}"
            CornerRadius="{Binding BoxCornerRadius, ElementName=RootLogoControl}"
            Background="{Binding BgColor, ElementName=RootLogoControl, Converter={local:HexToBrushConverter}}"
            BorderBrush="{Binding AccentColor, ElementName=RootLogoControl, Converter={local:HexToBrushConverter}}"
            BorderThickness="0.8"
            ClipToBounds="True">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 1. Antigravity: Quantum orbital ring & core -->
            <Grid x:Name="LogoAntigravity">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Antigravity">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="13" Height="13">
                    <Ellipse Stroke="#38BDF8" StrokeThickness="1" Width="13" Height="6" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-35" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Fill="#A855F7" Width="5.5" Height="5.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Fill="#FFFFFF" Width="2" Height="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1.5,1.5,0" />
                </Grid>
            </Grid>

            <!-- 2. Agy: Terminal prompt capsule >_ -->
            <Grid x:Name="LogoAgy">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Agy">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Viewbox Width="12" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="16" Height="14">
                        <Path Data="M 2,2 L 7.5,7 L 2,12" Stroke="#38BDF8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Line X1="9.5" Y1="12" X2="15.5" Y2="12" Stroke="#38BDF8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- 3. Claude Code: 8-point terracotta sunburst -->
            <Grid x:Name="LogoClaude">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Claude">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Path Data="M 8,0 L 9.3,5.3 L 14.6,2.3 L 11.6,7.6 L 16,8.9 L 11.6,10.2 L 14.6,15.5 L 9.3,12.5 L 8,17.8 L 6.7,12.5 L 1.4,15.5 L 4.4,10.2 L 0,8.9 L 4.4,7.6 L 1.4,2.3 L 6.7,5.3 Z"
                      Fill="#F59E0B" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 4. Cline: Dev robot visor in emerald -->
            <Grid x:Name="LogoCline">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Cline">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Viewbox Width="12" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="16" Height="14">
                        <Path Data="M 3,4 C 3,2.5 4.5,1.5 6,1.5 L 10,1.5 C 11.5,1.5 13,2.5 13,4 L 13,9 C 13,10.5 11.5,11.5 10,11.5 L 6,11.5 C 4.5,11.5 3,10.5 3,9 Z"
                              Stroke="#10B981" StrokeThickness="1.5" />
                        <Line X1="5.5" Y1="6.5" X2="10.5" Y2="6.5" Stroke="#10B981" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- 5. Gemini: Google 4-point sparkle star -->
            <Grid x:Name="LogoGemini">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Gemini">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Path Data="M 8,0 C 8,4.5 6,6.5 0,8 C 6,9.5 8,11.5 8,16 C 8,11.5 10,9.5 16,8 C 10,6.5 8,4.5 8,0 Z"
                      Fill="#4285F4" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 6. Codebuff: Vivid pink lightning hexagon -->
            <Grid x:Name="LogoCodebuff">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Codebuff">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Viewbox Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 8,1 L 14,4.5 L 14,11.5 L 8,15 L 2,11.5 L 2,4.5 Z" Stroke="#EC4899" StrokeThickness="1.2" />
                        <Path Data="M 9,4 L 5.5,9 L 8,9 L 7,12 L 10.5,7 L 8,7 Z" Fill="#EC4899" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- 7. OpenCode: Amber pair programming code brackets -->
            <Grid x:Name="LogoOpenCode">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="OpenCode">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Path Data="M 4.5,2 L 1,6 L 4.5,10 M 8.5,2 L 12,6 L 8.5,10"
                      Stroke="#F59E0B" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Width="11" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 8. Cursor: Precision editor dart -->
            <Grid x:Name="LogoCursor">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Cursor">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Path Data="M 2,1 L 12,6.5 L 7.5,7.8 L 5.5,12.5 Z"
                      Fill="#6366F1" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 9. Default Fallback: Prompt spark -->
            <Grid x:Name="LogoDefault">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Default">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock Text="⚡" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
