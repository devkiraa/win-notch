<UserControl x:Class="WinNotch.Controls.AgentLogoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinNotch"
             x:Name="RootLogoControl">
    <Grid Width="{Binding BoxSize, ElementName=RootLogoControl}"
          Height="{Binding BoxSize, ElementName=RootLogoControl}">
        
        <!-- Logo Capsule / Border -->
        <Border CornerRadius="{Binding BoxCornerRadius, ElementName=RootLogoControl}"
                Background="{Binding BgColor, ElementName=RootLogoControl, Converter={local:HexToBrushConverter}}"
                BorderBrush="{Binding AccentColor, ElementName=RootLogoControl, Converter={local:HexToBrushConverter}}"
                BorderThickness="0.8"
                ClipToBounds="True">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- 1. Antigravity: Real PNG Asset -->
                <Grid x:Name="LogoAntigravity">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Antigravity">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Image Source="/assets/antigravity-icon__full-color.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <!-- 2. Agy: Real PNG Asset (White for agy) -->
                <Grid x:Name="LogoAgy">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Agy">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Image Source="/assets/antigravity-icon__white_for_agy.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="1.5" />
                </Grid>

                <!-- 3. Claude Code: Real PNG Asset -->
                <Grid x:Name="LogoClaude">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Claude">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Image Source="/assets/claude_code.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="1" />
                </Grid>

                <!-- 4. Cline: Real PNG Asset -->
                <Grid x:Name="LogoCline">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Cline">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Image Source="/assets/cline.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="1" />
                </Grid>

                <!-- 5. Codebuff: Real JPG Asset -->
                <Grid x:Name="LogoCodebuff">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Codebuff">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Image Source="/assets/codebuff_logo.jpg"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <!-- 6. OpenCode: Real PNG Asset -->
                <Grid x:Name="LogoOpenCode">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="OpenCode">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Image Source="/assets/opencode.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="1" />
                </Grid>

                <!-- 7. Gemini: Google 4-point sparkle star -->
                <Grid x:Name="LogoGemini">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Gemini">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Path Data="M 8,0 C 8,4.5 6,6.5 0,8 C 6,9.5 8,11.5 8,16 C 8,11.5 10,9.5 16,8 C 10,6.5 8,4.5 8,0 Z"
                          Fill="#4285F4" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- 8. Cursor: Precision editor dart -->
                <Grid x:Name="LogoCursor">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Cursor">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Path Data="M 2,1 L 12,6.5 L 7.5,7.8 L 5.5,12.5 Z"
                          Fill="#6366F1" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- 9. Default Fallback: Prompt spark -->
                <Grid x:Name="LogoDefault">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="Default">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LogoKey, ElementName=RootLogoControl}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="⚡" FontSize="9" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom-Right Status Indicator Dot (Green if running, Grey if idle/standby) -->
        <Border x:Name="StatusDot"
                Width="5.5" Height="5.5" CornerRadius="3"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-1,-1"
                BorderBrush="#000000" BorderThickness="0.8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="#10B981" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowStatusDot, ElementName=RootLogoControl}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning, ElementName=RootLogoControl}" Value="False">
                            <Setter Property="Background" Value="#71717A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
